# Terraform working directory
.terraform/

# Terraform state files
*.tfstate
*.tfstate.*

# Terraform variable files containing sensitive data
terraform.tfvars
*.auto.tfvars

# Terraform crash logs
crash.log
crash.*.log

# Terraform plan files
# terraform/tfplan is committed on purpose as assignment evidence.
# Other saved plans stay out of version control.
*.tfplan

# Local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Environment and editor files
.env

# Credential downloads and archives
*.csv
*.tar.gz
.vscode/
# Sentinel local cache
.sentinel/
